        # multica:prepare-commit-msg:co-authored-by
        # Multica: add Co-authored-by trailer for the Multica Agent.
        # Installed by the Multica daemon. Do not edit — it will be overwritten.
        
        COMMIT_MSG_FILE="$1"
        COMMIT_SOURCE="$2"
        
