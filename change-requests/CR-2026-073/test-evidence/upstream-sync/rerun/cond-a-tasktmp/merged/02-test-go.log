tion:"Generate an interactive bash wizard that walks a human through steps only they can perform. Use when provisioning infrastructure, setting up credentials or CI secrets, walking an unfamiliar third-party dashboard, or running a one-off migration or cutover. Don't invoke this for steps the agent can perform itself.", SourcePath:"~/.claude/skills/wizard", Provider:"claude", Root:"provider", Plugin:"", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"writing-beats", Name:"writing-beats", Description:"Writing, exploit; assemble raw material into a journey of beats, grounding each term before a beat leans on it.", SourcePath:"~/.claude/skills/writing-beats", Provider:"claude", Root:"provider", Plugin:"", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"writing-for-agents", Name:"writing-for-agents", Description:"Writing documents for agents. Use when creating or editing skills, or modifying AGENTS.md or CLAUDE.md.", SourcePath:"~/.claude/skills/writing-for-agents", Provider:"claude", Root:"provider", Plugin:"", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"writing-fragments", Name:"writing-fragments", Description:"Writing, explore: mine raw fragments, no structure yet.", SourcePath:"~/.claude/skills/writing-fragments", Provider:"claude", Root:"provider", Plugin:"", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"writing-plans", Name:"writing-plans", Description:"Use when you have a spec or requirements for a multi-step task, before touching code", SourcePath:"~/.claude/skills/writing-plans", Provider:"claude", Root:"provider", Plugin:"", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"writing-shape", Name:"writing-shape", Description:"Writing, exploit: shape raw material into an article, paragraph by paragraph.", SourcePath:"~/.claude/skills/writing-shape", Provider:"claude", Root:"provider", Plugin:"", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key