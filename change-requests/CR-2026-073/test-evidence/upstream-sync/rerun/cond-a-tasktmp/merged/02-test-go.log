y:"writing-for-agents", Name:"writing-for-agents", Description:"Writing documents for agents. Use when creating or editing skills, or modifying AGENTS.md or CLAUDE.md.", SourcePath:"~/.minimax/skills/writing-for-agents", Provider:"mcode", Root:"provider", Plugin:"", CanDisable:false, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"writing-fragments", Name:"writing-fragments", Description:"Writing, explore: mine raw fragments, no structure yet.", SourcePath:"~/.minimax/skills/writing-fragments", Provider:"mcode", Root:"provider", Plugin:"", CanDisable:false, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"writing-plans", Name:"writing-plans", Description:"Use when you have a spec or requirements for a multi-step task, before touching code", SourcePath:"~/.minimax/skills/writing-plans", Provider:"mcode", Root:"provider", Plugin:"", CanDisable:false, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"writing-shape", Name:"writing-shape", Description:"Writing, exploit: shape raw material into an article, paragraph by paragraph.", SourcePath:"~/.minimax/skills/writing-shape", Provider:"mcode", Root:"provider", Plugin:"", CanDisable:false, FileCount:1}}
