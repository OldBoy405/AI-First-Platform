ount:2}, daemon.runtimeLocalSkillSummary{Key:"research", Name:"research", Description:"Investigate a question against high-trust primary sources and capture the findings as a Markdown file in the repo. Use when the user wants a topic researched, docs or API facts gathered, or reading legwork delegated to a background agent.", SourcePath:"~/.claude/skills/research", Provider:"claude", Root:"provider", Plugin:"", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"resolving-merge-conflicts", Name:"resolving-merge-conflicts", Description:"Use when you need to resolve an in-progress git merge/rebase conflict.", SourcePath:"~/.claude/skills/resolving-merge-conflicts", Provider:"claude", Root:"provider", Plugin:"", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"retro", Name:"retro", Description:"Conduct a retrospective on a coding session.", SourcePath:"~/.claude/skills/retro", Provider:"claude", Root:"provider", Plugin:"", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"scaffold-exercises", Name:"scaffold-exercises", Description:"Create exercise directory structures with sections, problems, solutions, and explainers that pass linting. Use when user wants to scaffold exercises, create exercise stubs, or set up a new course section.", SourcePath:"~/.claude/skills/scaffold-exercises", Provider:"claude", Root:"provider", Plugin:"", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"semantic-compression", Name:"semantic-compression", Description:"Re-encode verbose prose into a dense telegraphic register — punctuation as connectives, label frames, verbless assertions — without losing normativity or precision. Use when compressing system prompts, tool/function descriptions, skill bodies, or agent instructions; reducing token count or context bloat; making documentation token-efficient for LLM input; or rewriting text in compressed notation.", SourcePath:"~/.agents/skills/semantic-compression", Provider:"c