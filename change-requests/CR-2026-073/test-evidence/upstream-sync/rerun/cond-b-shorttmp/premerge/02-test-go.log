on.runtimeLocalSkillSummary{Key:"equity-research:initiating-coverage", Name:"equity-research:initiating-coverage", Description:"Create institutional-quality equity research initiation reports through a 5-task workflow. Tasks must be executed individually with verified prerequisites - (1) company research, (2) financial modeling, (3) valuation analysis, (4) chart generation, (5) final report assembly. Each task produces specific deliverables (markdown docs, Excel models, charts, or DOCX reports). Tasks 3-5 have dependencies on earlier tasks.", SourcePath:"~/.claude/plugins/cache/claude-for-financial-services/equity-research/0.1.2/skills/initiating-coverage", Provider:"claude", Root:"plugin", Plugin:"equity-research@claude-for-financial-services", CanDisable:true, FileCount:9}, daemon.runtimeLocalSkillSummary{Key:"equity-research:model-update", Name:"equity-research:model-update", Description:"Update financial models with new data — quarterly earnings, management guidance, macro changes, or revised assumptions. Adjusts estimates, recalculates valuation, and flags material changes. Use after earnings, guidance updates, or when assumptions need refreshing. Triggers on \"update model\", \"plug earnings\", \"refresh estimates\", \"update numbers for [company]\", \"new guidance\", or \"revise estimates\".", SourcePath:"~/.claude/plugins/cache/claude-for-financial-services/equity-research/0.1.2/skills/model-update", Provider:"claude", Root:"plugin", Plugin:"equity-research@claude-for-financial-services", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"equity-research:morning-note", Name:"equity-research:morning-note", Description:"Draft concise morning meeting notes summarizing overnight developments, trade ideas, and key events for coverage stocks. Designed for the 7am morning meeting format — tight, opinionated, actionable. Triggers on \"morning note\", \"morning meeting\", \"what happened overnight\", \"trade idea\", \"morning call prep\", or \"daily note\".", SourcePath:"~/.claude/plugins/cache/claude-for-financial-services/equity-research/0.1.2/skills/morning-note", Provider:"claude", Root:"plugin", Plugin:"equity-research@claude-for-financial-services", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"equity-research:sector-overview", Name:"equity-research:sector-overview", Description:"Create comprehensive industry and sector landscape reports covering market dynamics, competitive positioning, key players, and thematic trends. Use for client requests, sector initiations, thematic research pieces, or internal knowledge building. Triggers on \"sector overview\", \"industry report\", \"market landscape\", \"sector analysis\", \"industry deep dive\", or \"thematic research\".", SourcePath:"~/.claude/plugins/cache/claude-for-financial-services/equity-research/0.1.2/skills/sector-overview", Provider:"claude", Root:"plugin", Plugin:"equity-research@claude-for-financial-services", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"equity-research:thesis-tracker", Name:"equity-research:thesis-tracker", Description:"Maintain and update investment theses for portfolio positions and watchlist names. Track key data points, catalysts, and thesis milestones over time. Use when updating a thesis with new information, reviewing position rationale, or checking if a thesis is still intact. Triggers on \"update thesis for [company]\", \"is my thesis still intact\", \"thesis check\", \"add data point to [company]\", or \"review my positions\".", SourcePath:"~/.claude/plugins/cache/claude-for-financial-services/equity-research/0.1.2/skills/thesis-tracker", Provider:"claude", Root:"plugin", Plugin:"equity-research@claude-for-financial-services", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"executing-plans", Name:"executing-plans", Description:"Use when you have a written implementation plan to execute in a separate session with review checkpoints", SourcePath:"~/.claude/skills/executing-plans", Provider:"claude", Root:"provider", Plugin:"", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"financial-analysis:3-statement-model", Name:"financial-analysis:3-statement-model", Description:"Complete, populate and fill out 3-statement financial model templates (Income Statement, Balance Sheet, Cash Flow Statement) . Use when asked to fill out model templates, complete existing model frameworks, populate financial models with data, complete a partially filled IS/BS/CF framework, or link integrated financial statements within an existing template structure. Triggers include requests to fill in, complete, or populate a 3-statement model template", SourcePath:"~/.claude/plugins/cache/claude-for-financial-services/financial-analysis/0.1.1/skills/3-statement-model", Provider:"claude", Root:"plugin", Plugin:"financial-analysis@claude-for-financial-services", CanDisable:true, FileCount:4}, daemon.runtimeLocalSkillSummary{Key:"financial-analysis:audit-xls", Name:"financial-analysis:audit-xls", Description:"Audit a spreadsheet for formula accuracy, errors, and common mistakes. Scopes to a selected range, a single sheet, or the entire model (including financial-model integrity checks like BS balance, cash tie-out, and logic sanity). Triggers on \"audit this sheet\", \"check my formulas\", \"find formula errors\", \"QA this spreadsheet\", \"sanity check this\", \"debug model\", \"model check\", \"model won't balance\", \"something's off in my model\", \"model review\".", SourcePath:"~/.claude/plugins/cache/claude-for-financial-services/financial-analysis/0.1.1/skills/audit-xls", Provider:"claude", Root:"plugin", Plugin:"financial-analysis@claude-for-financial-services", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"financial-analysis:clean-data-xls", Name:"financial-analysis:clean-data-xls", Description:"Clean up messy spreadsheet data — trim whitespace, fix inconsistent casing, convert numbers-stored-as-text, standardize dates, remove duplicates, and flag mixed-type columns. Use when data is messy, inconsistent, or needs prep before analysis. Triggers on \"clean this data\", \"clean up this sheet\", \"normalize this data\", \"fix formatting\", \"dedupe\", \"standardize this column\", \"this data is messy\".", SourcePath:"~/.claude/plugins/cache/claude-for-financial-services/financial-analysis/0.1.1/skills/clean-data-xls", Provider:"claude", Root:"plugin", Plugin:"financial-analysis@claude-for-financial-services", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"financial-analysis:competitive-analysis", Name:"financial-analysis:competitive-analysis", Description:"Framework for building competitive landscape decks — market positioning, competitor deep-dives, comparative analysis, strategic synthesis. Use when the user asks for a competitive landscape, competitor analysis, peer comparison, market positioning assessment, strategic review, or investment memo deck. Also triggers on \"who are the competitors to X\", \"benchmark X against peers\", \"build a market map\", or any request to systematically evaluate competitive dynamics across an industry.", SourcePath:"~/.claude/plugins/cache/claude-for-financial-services/financial-analysis/0.1.1/skills/competitive-analysis", Provider:"claude", Root:"plugin", Plugin:"financial-analysis@claude-for-financial-services", CanDisable:true, FileCount:3}, daemon.runtimeLocalSkillSummary{Key:"financial-analysis:comps-analysis", Name:"financial-analysis:comps-analysis", Description:"Build institutional-grade comparable company analyses with operating metrics, valuation multiples, and statistical benchmarking in Excel/spreadsheet format.\n\n**Perfect for:**\n- Public company valuation (M&A, investment analysis)\n- Benchmarking performance vs. industry peers\n- Pricing IPOs or funding rounds\n- Identifying valuation outliers (over/under-valued)\n- Supporting investment committee presentations\n- Creating sector overview reports\n\n**Not ideal for:**\n- Private companies without comparable public peers\n- Highly diversified conglomerates\n- Distressed/bankrupt companies\n- Pre-revenue startups\n- Companies with unique business models", SourcePath:"~/.claude/plugins/cache/claude-for-financial-services/financial-analysis/0.1.1/skills/comps-analysis", Provider:"claude", Root:"plugin", Plugin:"financial-analysis@claude-for-financial-services", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"financial-analysis:dcf-model", Name:"financial-analysis:dcf-model", Description:"Real DCF (Discounted Cash Flow) model creation for equity valuation. Retrieves financial data from SEC filings and analyst reports, builds comprehensive cash flow projections with proper WACC calculations, performs sensitivity analysis, and outputs professional Excel models with executive summaries. Use when users need to value a company using DCF methodology, request intrinsic value analysis, or ask for detailed financial modeling with growth projections and terminal value calculations.", SourcePath:"~/.claude/plugins/cache/claude-for-financial-services/financial-analysis/0.1.1/skills/dcf-model", Provider:"claude", Root:"plugin", Plugin:"financial-analysis@claude-for-financial-services", CanDisable:true, FileCount:4}, daemon.runtimeLocalSkillSummary{Key:"financial-analysis:deck-refresh", Name:"financial-analysis:deck-refresh", Description:"Updates a presentation with new numbers — quarterly refreshes, earnings updates, comp rolls, rebased market data. Use whenever the user asks to \"update the deck with Q4 numbers\", \"refresh the comps\", \"roll this forward\", \"swap in the new earnings\", \"change all the $485M to $512M\", or any request to swap figures across an existing deck without rebuilding it.", SourcePath:"~/.claude/plugins/cache/claude-for-financial-services/financial-analysis/0.1.1/skills/deck-refresh", Provider:"claude", Root:"plugin", Plugin:"financial-analysis@claude-for-financial-services", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"financial-analysis:ib-check-deck", Name:"financial-analysis:ib-check-deck", Description:"Investment banking presentation quality checker. Reviews a pitch deck or client-ready presentation for (1) number consistency across slides, (2) data-narrative alignment, (3) language polish against IB standards, (4) visual and formatting QC. Use whenever the user asks to review, check, QC, proof, or do a final pass on a deck, pitch, or client materials — including requests like \"check my numbers\", \"reconcile figures across slides\", \"is this client-ready\", or \"what am I missing before I send this out\".", SourcePath:"~/.claude/plugins/cache/claude-for-financial-services/financial-analysis/0.1.1/skills/ib-check-deck", Provider:"claude", Root:"plugin", Plugin:"financial-analysis@claude-for-financial-services", CanDisable:true, FileCount:4}, daemon.runtimeLocalSkillSummary{Key:"financial-analysis:lbo-model", Name:"financial-analysis:lbo-model", Description:"This skill should be used when completing LBO (Leveraged Buyout) model templates in Excel for private equity transactions, deal materials, or investment committee presentations. The skill fills in formulas, validates calculations, and ensures professional formatting standards that adapt to any template structure.", SourcePath:"~/.claude/plugins/cache/claude-for-financial-services/financial-analysis/0.1.1/skills/lbo-model", Provider:"claude", Root:"plugin", Plugin:"financial-analysis@claude-for-financial-services", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"financial-analysis:ppt-template-creator", Name:"financial-analysis:ppt-template-creator", Description:"Creates self-contained PPT template SKILLS (not presentations) from user-provided PowerPoint templates. Use ONLY when a user wants to create a reusable skill from their template. For creating actual presentations, use the pptx skill instead.", SourcePath:"~/.claude/plugins/cache/claude-for-financial-services/financial-analysis/0.1.1/skills/ppt-template-creator", Provider:"claude", Root:"plugin", Plugin:"financial-analysis@claude-for-financial-services", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"financial-analysis:pptx-author", Name:"financial-analysis:pptx-author", Description:"Produce a .pptx file on disk (headless) instead of driving a live PowerPoint document — for managed-agent sessions with no open Office app.", SourcePath:"~/.claude/plugins/cache/claude-for-financial-services/financial-analysis/0.1.1/skills/pptx-author", Provider:"claude", Root:"plugin", Plugin:"financial-analysis@claude-for-financial-services", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"financial-analysis:skill-creator", Name:"financial-analysis:skill-creator", Description:"Guide for creating effective skills. This skill should be used when users want to create a new skill (or update an existing skill) that extends Claude's capabilities with specialized knowledge, workflows, or tool integrations.", SourcePath:"~/.claude/plugins/cache/claude-for-financial-services/financial-analysis/0.1.1/skills/skill-creator", Provider:"claude", Root:"plugin", Plugin:"financial-analysis@claude-for-financial-services", CanDisable:true, FileCount:6}, daemon.runtimeLocalSkillSummary{Key:"financial-analysis:xlsx-author", Name:"financial-analysis:xlsx-author", Description:"Produce a .xlsx file on disk (headless) instead of driving a live Excel workbook — for managed-agent sessions with no open Office app.", SourcePath:"~/.claude/plugins/cache/claude-for-financial-services/financial-analysis/0.1.1/skills/xlsx-author", Provider:"claude", Root:"plugin", Plugin:"financial-analysis@claude-for-financial-services", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"finishing-a-development-branch", Name:"finishing-a-development-branch", Description:"Use when implementation is complete, all tests pass, and you need to decide how to integrate the work", SourcePath:"~/.claude/skills/finishing-a-development-branch", Provider:"claude", Root:"provider", Plugin:"", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"full-output-enforcement", Name:"full-output-enforcement", Description:"Overrides default LLM truncation behavior. Enforces complete code generation, bans placeholder patterns, and handles token-limit splits cleanly. Apply to any task requiring exhaustive, unabridged output.", SourcePath:"~/.claude/skills/full-output-enforcement", Provider:"claude", Root:"provider", Plugin:"", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"git-guardrails-claude-code", Name:"git-guardrails-claude-code", Description:"Set up Claude Code hooks to block dangerous git commands (push, reset --hard, clean, branch -D, etc.) before they execute. Use when user wants to prevent destructive git operations, add git safety hooks, or block git push/reset in Claude Code.", SourcePath:"~/.claude/skills/git-guardrails-claude-code", Provider:"claude", Root:"provider", Plugin:"", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"gpt-taste", Name:"gpt-taste", Description:"Elite UX/UI & Advanced GSAP Motion Engineer. Enforces Python-driven true randomization for layout variance, strict AIDA page structure, wide editorial typography (bans 6-line wraps), gapless bento grids, strict GSAP ScrollTriggers (pinning, stacking, scrubbing), inline micro-images, and massive section spacing.", SourcePath:"~/.claude/skills/gpt-taste", Provider:"claude", Root:"provider", Plugin:"", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"graphify", Name:"graphify-windows", Description:"Use for any question about a codebase, its architecture, file relationships, or project content — especially when graphify-out/ exists, where the question should be treated as a graphify query first. Turns any input (code, docs, papers, images, videos) into a persistent knowledge graph with god nodes, community detection, and query/path/explain tools.", SourcePath:"~/.claude/skills/graphify", Provider:"claude", Root:"provider", Plugin:"", CanDisable:true, FileCount:9}, daemon.runtimeLocalSkillSummary{Key:"grill-me", Name:"grill-me", Description:"A relentless interview to sharpen a plan or design.", SourcePath:"~/.claude/skills/grill-me", Provider:"claude", Root:"provider", Plugin:"", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"grill-with-docs", Name:"grill-with-docs", Description:"A relentless interview to sharpen a plan or design, which also creates docs (ADR's and glossary) as we go.", SourcePath:"~/.claude/skills/grill-with-docs", Provider:"claude", Root:"provider", Plugin:"", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"grilling", Name:"grilling", Description:"Grill the user relentlessly about a plan, decision, or idea. Use when the user wants to stress-test their thinking, or uses any 'grill' trigger phrases.", SourcePath:"~/.claude/skills/grilling", Provider:"claude", Root:"provider", Plugin:"", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"handoff", Name:"handoff", Description:"Compact the current conversation into a handoff document for another agent to pick up.", SourcePath:"~/.claude/skills/handoff", Provider:"claude", Root:"provider", Plugin:"", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"high-end-visual-design", Name:"high-end-visual-design", Description:"Teaches the AI to design like a high-end agency. Defines the exact fonts, spacing, shadows, card structures, and animations that make a website feel expensive. Blocks all the common defaults that make AI designs look cheap or generic.", SourcePath:"~/.claude/skills/high-end-visual-design", Provider:"claude", Root:"provider", Plugin:"", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"image-to-code", Name:"image-to-code", Description:"Elite website image-to-code skill for Codex. For visually important web tasks, it must first generate the design image(s) itself, deeply analyze them, then implement the website to match them as closely as possible. In Codex, it must prefer large, readable, section-specific images instead of tiny compressed boards, generate fresh standalone images for sections or detail views instead of cropping old ones, avoid lazy under-generation, avoid cards-inside-cards-inside-cards UI, and keep the hero clean, spacious, readable, and visible on a small laptop.", SourcePath:"~/.claude/skills/image-to-code", Provider:"claude", Root:"provider", Plugin:"", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"imagegen-frontend-mobile", Name:"imagegen-frontend-mobile", Description:"Elite mobile app image-generation skill for creating premium, app-native screen concepts and flows. Designed for iOS, Android, and cross-platform mobile products. Prioritizes clean hierarchy, comfortably readable text, strong multi-screen consistency, controlled color palettes, non-generic creative direction, textured surfaces, image-led composition, tasteful custom iconography, and clean phone mockup framing. By default, screens should be shown inside a subtle premium iPhone or similar phone mockup with a visible frame, while the main focus stays on the app content itself. This skill generates images only. It does not write code.", SourcePath:"~/.claude/skills/imagegen-frontend-mobile", Provider:"claude", Root:"provider", Plugin:"", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"imagegen-frontend-web", Name:"imagegen-frontend-web", Description:"Elite frontend image-direction skill for generating premium, conversion-aware website design references. CRITICAL OUTPUT RULE — generate ONE separate horizontal image FOR EVERY section. A landing page with 8 sections produces 8 images. Never compress multiple sections into one image. Enforces composition variety (not always left-text / right-image), background-image freedom, varied CTAs, varied hero scales (giant / mid / mini minimalist), narrative concept spine, second-read moments, and a single consistent palette across all images. Optimized for landing pages, marketing sites, and product comps that developers or coding models can accurately recreate.", SourcePath:"~/.claude/skills/imagegen-frontend-web", Provider:"claude", Root:"provider", Plugin:"", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"implement", Name:"implement", Description:"Implement a piece of work based on a spec or set of tickets.", SourcePath:"~/.claude/skills/implement", Provider:"claude", Root:"provider", Plugin:"", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"implement-spec", Name:"implement-spec", Description:"Implement a specification in code.", SourcePath:"~/.claude/skills/implement-spec", Provider:"claude", Root:"provider", Plugin:"", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"improve-codebase-architecture", Name:"improve-codebase-architecture", Description:"Scan a codebase for deepening opportunities, present them as a visual HTML report, then grill through whichever one you pick.", SourcePath:"~/.claude/skills/improve-codebase-architecture", Provider:"claude", Root:"provider", Plugin:"", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"industrial-brutalist-ui", Name:"industrial-brutalist-ui", Description:"Raw mechanical interfaces fusing Swiss typographic print with military terminal aesthetics. Rigid grids, extreme type scale contrast, utilitarian color, analog degradation effects. For data-heavy dashboards, portfolios, or editorial sites that need to feel like declassified blueprints.", SourcePath:"~/.claude/skills/industrial-brutalist-ui", Provider:"claude", Root:"provider", Plugin:"", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"jev-ultrafast", Name:"jev-ultrafast", Description:"", SourcePath:"~/.agents/skills/jev-ultrafast", Provider:"claude", Root:"universal", Plugin:"", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"karpathy-guidelines", Name:"karpathy-guidelines", Description:"Behavioral guidelines to reduce common LLM coding mistakes. Use when writing, reviewing, or refactoring code to avoid overcomplication, make surgical changes, surface assumptions, and define verifiable success criteria.", SourcePath:"~/.claude/skills/karpathy-guidelines", Provider:"claude", Root:"provider", Plugin:"", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"loop-me", Name:"loop-me", Description:"Grill me about specs for the workflows I want to build, within this workspace.", SourcePath:"~/.claude/skills/loop-me", Provider:"claude", Root:"provider", Plugin:"", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"market-researcher:competitive-analysis", Name:"market-researcher:competitive-analysis", Description:"Framework for building competitive landscape decks — market positioning, competitor deep-dives, comparative analysis, strategic synthesis. Use when the user asks for a competitive landscape, competitor analysis, peer comparison, market positioning assessment, strategic review, or investment memo deck. Also triggers on \"who are the competitors to X\", \"benchmark X against peers\", \"build a market map\", or any request to systematically evaluate competitive dynamics across an industry.", SourcePath:"~/.claude/plugins/cache/claude-for-financial-services/market-researcher/0.1.1/skills/competitive-analysis", Provider:"claude", Root:"plugin", Plugin:"market-researcher@claude-for-financial-services", CanDisable:true, FileCount:3}, daemon.runtimeLocalSkillSummary{Key:"market-researcher:comps-analysis", Name:"market-researcher:comps-analysis", Description:"Build institutional-grade comparable company analyses with operating metrics, valuation multiples, and statistical benchmarking in Excel/spreadsheet format.\n\n**Perfect for:**\n- Public company valuation (M&A, investment analysis)\n- Benchmarking performance vs. industry peers\n- Pricing IPOs or funding rounds\n- Identifying valuation outliers (over/under-valued)\n- Supporting investment committee presentations\n- Creating sector overview reports\n\n**Not ideal for:**\n- Private companies without comparable public peers\n- Highly diversified conglomerates\n- Distressed/bankrupt companies\n- Pre-revenue startups\n- Companies with unique business models", SourcePath:"~/.claude/plugins/cache/claude-for-financial-services/market-researcher/0.1.1/skills/comps-analysis", Provider:"claude", Root:"plugin", Plugin:"market-researcher@claude-for-financial-services", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"market-researcher:idea-generation", Name:"market-researcher:idea-generation", Description:"Systematic stock screening and investment idea sourcing. Combines quantitative screens, thematic research, and pattern recognition to surface new long and short ideas. Use when looking for new ideas, running screens, or conducting thematic sweeps. Triggers on \"idea generation\", \"stock screen\", \"find ideas\", \"what looks interesting\", \"screen for\", \"new ideas\", or \"pitch me something\".", SourcePath:"~/.claude/plugins/cache/claude-for-financial-services/market-researcher/0.1.1/skills/idea-generation", Provider:"claude", Root:"plugin", Plugin:"market-researcher@claude-for-financial-services", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"market-researcher:pptx-author", Name:"market-researcher:pptx-author", Description:"Produce a .pptx file on disk (headless) instead of driving a live PowerPoint document — for managed-agent sessions with no open Office app.", SourcePath:"~/.claude/plugins/cache/claude-for-financial-services/market-researcher/0.1.1/skills/pptx-author", Provider:"claude", Root:"plugin", Plugin:"market-researcher@claude-for-financial-services", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"market-researcher:sector-overview", Name:"market-researcher:sector-overview", Description:"Create comprehensive industry and sector landscape reports covering market dynamics, competitive positioning, key players, and thematic trends. Use for client requests, sector initiations, thematic research pieces, or internal knowledge building. Triggers on \"sector overview\", \"industry report\", \"market landscape\", \"sector analysis\", \"industry deep dive\", or \"thematic research\".", SourcePath:"~/.claude/plugins/cache/claude-for-financial-services/market-researcher/0.1.1/skills/sector-overview", Provider:"claude", Root:"plugin", Plugin:"market-researcher@claude-for-financial-services", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"migrate-to-shoehorn", Name:"migrate-to-shoehorn", Description:"Migrate test files from `as` type assertions to @total-typescript/shoehorn. Use when user mentions shoehorn, wants to replace `as` in tests, or needs partial test data.", SourcePath:"~/.claude/skills/migrate-to-shoehorn", Provider:"claude", Root:"provider", Plugin:"", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"minimalist-ui", Name:"minimalist-ui", Description:"Clean editorial-style interfaces. Warm monochrome palette, typographic contrast, flat bento grids, muted pastels. No gradients, no heavy shadows.", SourcePath:"~/.claude/skills/minimalist-ui", Provider:"claude", Root:"provider", Plugin:"", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"model-builder:3-statement-model", Name:"model-builder:3-statement-model", Description:"Complete, populate and fill out 3-statement financial model templates (Income Statement, Balance Sheet, Cash Flow Statement) . Use when asked to fill out model templates, complete existing model frameworks, populate financial models with data, complete a partially filled IS/BS/CF framework, or link integrated financial statements within an existing template structure. Triggers include requests to fill in, complete, or populate a 3-statement model template", SourcePath:"~/.claude/plugins/cache/claude-for-financial-services/model-builder/0.1.0/skills/3-statement-model", Provider:"claude", Root:"plugin", Plugin:"model-builder@claude-for-financial-services", CanDisable:true, FileCount:4}, daemon.runtimeLocalSkillSummary{Key:"model-builder:audit-xls", Name:"model-builder:audit-xls", Description:"Audit a spreadsheet for formula accuracy, errors, and common mistakes. Scopes to a selected range, a single sheet, or the entire model (including financial-model integrity checks like BS balance, cash tie-out, and logic sanity). Triggers on \"audit this sheet\", \"check my formulas\", \"find formula errors\", \"QA this spreadsheet\", \"sanity check this\", \"debug model\", \"model check\", \"model won't balance\", \"something's off in my model\", \"model review\".", SourcePath:"~/.claude/plugins/cache/claude-for-financial-services/model-builder/0.1.0/skills/audit-xls", Provider:"claude", Root:"plugin", Plugin:"model-builder@claude-for-financial-services", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"model-builder:comps-analysis", Name:"model-builder:comps-analysis", Description:"Build institutional-grade comparable company analyses with operating metrics, valuation multiples, and statistical benchmarking in Excel/spreadsheet format.\n\n**Perfect for:**\n- Public company valuation (M&A, investment analysis)\n- Benchmarking performance vs. industry peers\n- Pricing IPOs or funding rounds\n- Identifying valuation outliers (over/under-valued)\n- Supporting investment committee presentations\n- Creating sector overview reports\n\n**Not ideal for:**\n- Private companies without comparable public peers\n- Highly diversified conglomerates\n- Distressed/bankrupt companies\n- Pre-revenue startups\n- Companies with unique business models", SourcePath:"~/.claude/plugins/cache/claude-for-financial-services/model-builder/0.1.0/skills/comps-analysis", Provider:"claude", Root:"plugin", Plugin:"model-builder@claude-for-financial-services", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"model-builder:dcf-model", Name:"model-builder:dcf-model", Description:"Real DCF (Discounted Cash Flow) model creation for equity valuation. Retrieves financial data from SEC filings and analyst reports, builds comprehensive cash flow projections with proper WACC calculations, performs sensitivity analysis, and outputs professional Excel models with executive summaries. Use when users need to value a company using DCF methodology, request intrinsic value analysis, or ask for detailed financial modeling with growth projections and terminal value calculations.", SourcePath:"~/.claude/plugins/cache/claude-for-financial-services/model-builder/0.1.0/skills/dcf-model", Provider:"claude", Root:"plugin", Plugin:"model-builder@claude-for-financial-services", CanDisable:true, FileCount:4}, daemon.runtimeLocalSkillSummary{Key:"model-builder:lbo-model", Name:"model-builder:lbo-model", Description:"This skill should be used when completing LBO (Leveraged Buyout) model templates in Excel for private equity transactions, deal materials, or investment committee presentations. The skill fills in formulas, validates calculations, and ensures professional formatting standards that adapt to any template structure.", SourcePath:"~/.claude/plugins/cache/claude-for-financial-services/model-builder/0.1.0/skills/lbo-model", Provider:"claude", Root:"plugin", Plugin:"model-builder@claude-for-financial-services", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"model-builder:xlsx-author", Name:"model-builder:xlsx-author", Description:"Produce a .xlsx file on disk (headless) instead of driving a live Excel workbook — for managed-agent sessions with no open Office app.", SourcePath:"~/.claude/plugins/cache/claude-for-financial-services/model-builder/0.1.0/skills/xlsx-author", Provider:"claude", Root:"plugin", Plugin:"model-builder@claude-for-financial-services", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"ponytail", Name:"ponytail", Description:"Forces the laziest solution that actually works, simplest, shortest, most minimal. Channels a senior dev who has seen everything: question whether the task needs to exist at all (YAGNI), reach for the standard library before custom code, native platform features before dependencies, one line before fifty. Supports intensity levels: lite, full (default), ultra. Use on ANY coding task: writing, adding, refactoring, fixing, reviewing, or designing code, and choosing libraries or dependencies. Also use whenever the user says \"ponytail\", \"be lazy\", \"lazy mode\", \"simplest solution\", \"minimal solution\", \"yagni\", \"do less\", or \"shortest path\", or complains about over-engineering, bloat, boilerplate, or unnecessary dependencies. Do NOT use for non-coding requests (general knowledge, prose, translation, summaries, recipes).", SourcePath:"~/.claude/skills/ponytail", Provider:"claude", Root:"provider", Plugin:"", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"ponytail-audit", Name:"ponytail-audit", Description:"Whole-repo audit for over-engineering. Like ponytail-review, but scans the entire codebase instead of a diff: a ranked list of what to delete, simplify, or replace with stdlib/native equivalents. Use when the user says \"audit this codebase\", \"audit for over-engineering\", \"what can I delete from this repo\", \"find bloat\", \"ponytail-audit\", or \"/ponytail-audit\". One-shot report, does not apply fixes.", SourcePath:"~/.claude/skills/ponytail-audit", Provider:"claude", Root:"provider", Plugin:"", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"ponytail-debt", Name:"ponytail-debt", Description:"Harvest every `ponytail:` comment in the codebase into a debt ledger, so the deliberate shortcuts and deferrals ponytail leaves behind get tracked instead of rotting into \"later means never\". Use when the user says \"ponytail debt\", \"/ponytail-debt\", \"what did ponytail defer\", \"list the shortcuts\", \"ponytail ledger\", or \"what did we mark to do later\". One-shot report, changes nothing.", SourcePath:"~/.claude/skills/ponytail-debt", Provider:"claude", Root:"provider", Plugin:"", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"ponytail-gain", Name:"ponytail-gain", Description:"Show ponytail's measured impact as a compact scoreboard: less code, less cost, more speed, from the benchmark medians. One-shot display, not a persistent mode, and not a per-repo number. Trigger: /ponytail-gain, \"ponytail gain\", \"what does ponytail save\", \"show ponytail impact\", \"ponytail scoreboard\".", SourcePath:"~/.claude/skills/ponytail-gain", Provider:"claude", Root:"provider", Plugin:"", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"ponytail-help", Name:"ponytail-help", Description:"Quick-reference card for all ponytail modes, skills, and commands. One-shot display, not a persistent mode. Trigger: /ponytail-help, \"ponytail help\", \"what ponytail commands\", \"how do I use ponytail\".", SourcePath:"~/.claude/skills/ponytail-help", Provider:"claude", Root:"provider", Plugin:"", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"ponytail-review", Name:"ponytail-review", Description:"Code review focused exclusively on over-engineering. Finds what to delete: reinvented standard library, unneeded dependencies, speculative abstractions, dead flexibility. One line per finding: location, what to cut, what replaces it. Use when the user says \"review for over-engineering\", \"what can we delete\", \"is this over-engineered\", \"simplify review\", or invokes /ponytail-review. Complements correctness-focused review, this one only hunts complexity.", SourcePath:"~/.claude/skills/ponytail-review", Provider:"claude", Root:"provider", Plugin:"", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"ponytail:ponytail", Name:"ponytail:ponytail", Description:"Forces the laziest solution that actually works, simplest, shortest, most minimal. Channels a senior dev who has seen everything: question whether the task needs to exist at all (YAGNI), reach for the standard library before custom code, native platform features before dependencies, one line before fifty. Supports intensity levels: lite, full (default), ultra. Use on ANY coding task: writing, adding, refactoring, fixing, reviewing, or designing code, and choosing libraries or dependencies. Also use whenever the user says \"ponytail\", \"be lazy\", \"lazy mode\", \"simplest solution\", \"minimal solution\", \"yagni\", \"do less\", or \"shortest path\", or complains about over-engineering, bloat, boilerplate, or unnecessary dependencies. Do NOT use for non-coding requests (general knowledge, prose, translation, summaries, recipes).", SourcePath:"~/.claude/plugins/cache/ponytail/ponytail/4.8.4/skills/ponytail", Provider:"claude", Root:"plugin", Plugin:"ponytail@ponytail", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"ponytail:ponytail-audit", Name:"ponytail:ponytail-audit", Description:"Whole-repo audit for over-engineering. Like ponytail-review, but scans the entire codebase instead of a diff: a ranked list of what to delete, simplify, or replace with stdlib/native equivalents. Use when the user says \"audit this codebase\", \"audit for over-engineering\", \"what can I delete from this repo\", \"find bloat\", \"ponytail-audit\", or \"/ponytail-audit\". One-shot report, does not apply fixes.", SourcePath:"~/.claude/plugins/cache/ponytail/ponytail/4.8.4/skills/ponytail-audit", Provider:"claude", Root:"plugin", Plugin:"ponytail@ponytail", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"ponytail:ponytail-debt", Name:"ponytail:ponytail-debt", Description:"Harvest every `ponytail:` comment in the codebase into a debt ledger, so the deliberate shortcuts and deferrals ponytail leaves behind get tracked instead of rotting into \"later means never\". Use when the user says \"ponytail debt\", \"/ponytail-debt\", \"what did ponytail defer\", \"list the shortcuts\", \"ponytail ledger\", or \"what did we mark to do later\". One-shot report, changes nothing.", SourcePath:"~/.claude/plugins/cache/ponytail/ponytail/4.8.4/skills/ponytail-debt", Provider:"claude", Root:"plugin", Plugin:"ponytail@ponytail", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"ponytail:ponytail-gain", Name:"ponytail:ponytail-gain", Description:"Show ponytail's measured impact as a compact scoreboard: less code, less cost, more speed, from the benchmark medians. One-shot display, not a persistent mode, and not a per-repo number. Trigger: /ponytail-gain, \"ponytail gain\", \"what does ponytail save\", \"show ponytail impact\", \"ponytail scoreboard\".", SourcePath:"~/.claude/plugins/cache/ponytail/ponytail/4.8.4/skills/ponytail-gain", Provider:"claude", Root:"plugin", Plugin:"ponytail@ponytail", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"ponytail:ponytail-help", Name:"ponytail:ponytail-help", Description:"Quick-reference card for all ponytail modes, skills, and commands. One-shot display, not a persistent mode. Trigger: /ponytail-help, \"ponytail help\", \"what ponytail commands\", \"how do I use ponytail\".", SourcePath:"~/.claude/plugins/cache/ponytail/ponytail/4.8.4/skills/ponytail-help", Provider:"claude", Root:"plugin", Plugin:"ponytail@ponytail", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"ponytail:ponytail-review", Name:"ponytail:ponytail-review", Description:"Code review focused exclusively on over-engineering. Finds what to delete: reinvented standard library, unneeded dependencies, speculative abstractions, dead flexibility. One line per finding: location, what to cut, what replaces it. Use when the user says \"review for over-engineering\", \"what can we delete\", \"is this over-engineered\", \"simplify review\", or invokes /ponytail-review. Complements correctness-focused review, this one only hunts complexity.", SourcePath:"~/.claude/plugins/cache/ponytail/ponytail/4.8.4/skills/ponytail-review", Provider:"claude", Root:"plugin", Plugin:"ponytail@ponytail", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"prototype", Name:"prototype", Description:"Build a throwaway prototype to answer a design question. Use when the user wants to sanity-check whether a state model or logic feels right, or explore what a UI should look like.", SourcePath:"~/.claude/skills/prototype", Provider:"claude", Root:"provider", Plugin:"", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"receiving-code-review", Name:"receiving-code-review", Description:"Use when receiving code review feedback, before implementing suggestions, especially if feedback seems unclear or technically questionable - requires technical rigor and verification, not performative agreement or blind implementation", SourcePath:"~/.claude/skills/receiving-code-review", Provider:"claude", Root:"provider", Plugin:"", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"redesign-existing-projects", Name:"redesign-existing-projects", Description:"Upgrades existing websites and apps to premium quality. Audits current design, identifies generic AI patterns, and applies high-end design standards without breaking functionality. Works with any CSS framework or vanilla CSS.", SourcePath:"~/.claude/skills/redesign-existing-projects", Provider:"claude", Root:"provider", Plugin:"", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"requesting-code-review", Name:"requesting-code-review", Description:"Use when completing tasks, implementing major features, or before merging to verify work meets requirements", SourcePath:"~/.claude/skills/requesting-code-review", Provider:"claude", Root:"provider", Plugin:"", CanDisable:true, FileCount:2}, daemon.runtimeLocalSkillSummary{Key:"research", Name:"research", Description:"Investigate a question against high-trust primary sources and capture the findings as a Markdown file in the repo. Use when the user wants a topic researched, docs or API facts gathered, or reading legwork delegated to a background agent.", SourcePath:"~/.claude/skills/research", Provider:"claude", Root:"provider", Plugin:"", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"resolving-merge-conflicts", Name:"resolving-merge-conflicts", Description:"Use when you need to resolve an in-progress git merge/rebase conflict.", SourcePath:"~/.claude/skills/resolving-merge-conflicts", Provider:"claude", Root:"provider", Plugin:"", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"retro", Name:"retro", Description:"Conduct a retrospective on a coding session.", SourcePath:"~/.claude/skills/retro", Provider:"claude", Root:"provider", Plugin:"", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"scaffold-exercises", Name:"scaffold-exercises", Description:"Create exercise directory structures with sections, problems, solutions, and explainers that pass linting. Use when user wants to scaffold exercises, create exercise stubs, or set up a new course section.", SourcePath:"~/.claude/skills/scaffold-exercises", Provider:"claude", Root:"provider", Plugin:"", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"semantic-compression", Name:"semantic-compression", Description:"Re-encode verbose prose into a dense telegraphic register — punctuation as connectives, label frames, verbless assertions — without losing normativity or precision. Use when compressing system prompts, tool/function descriptions, skill bodies, or agent instructions; reducing token count or context bloat; making documentation token-efficient for LLM input; or rewriting text in compressed notation.", SourcePath:"~/.agents/skills/semantic-compression", Provider:"claude", Root:"universal", Plugin:"", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"setup-matt-pocock-skills", Name:"setup-matt-pocock-skills", Description:"Configure this repo for the engineering skills: set up its issue tracker, triage label vocabulary, and domain doc layout. Run once before first use of the other engineering skills.", SourcePath:"~/.claude/skills/setup-matt-pocock-skills", Provider:"claude", Root:"provider", Plugin:"", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"setup-pre-commit", Name:"setup-pre-commit", Description:"Set up Husky pre-commit hooks with lint-staged (Prettier), type checking, and tests in the current repo. Use when user wants to add pre-commit hooks, set up Husky, configure lint-staged, or add commit-time formatting/typechecking/testing.", SourcePath:"~/.claude/skills/setup-pre-commit", Provider:"claude", Root:"provider", Plugin:"", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"setup-ts-deep-modules", Name:"setup-ts-deep-modules", Description:"Wire dependency-cruiser into a TypeScript repo so each package is a deep module, with implementation hidden in subfolders and reachable only through its entry-point files. User-invoked.", SourcePath:"~/.claude/skills/setup-ts-deep-modules", Provider:"claude", Root:"provider", Plugin:"", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"stitch-design-taste", Name:"stitch-design-taste", Description:"Semantic Design System Skill for Google Stitch. Generates agent-friendly DESIGN.md files that enforce premium, anti-generic UI standards — strict typography, calibrated color, asymmetric layouts, perpetual micro-motion, and hardware-accelerated performance.", SourcePath:"~/.claude/skills/stitch-design-taste", Provider:"claude", Root:"provider", Plugin:"", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"subagent-driven-development", Name:"subagent-driven-development", Description:"Use when executing implementation plans with independent tasks in the current session", SourcePath:"~/.claude/skills/subagent-driven-development", Provider:"claude", Root:"provider", Plugin:"", CanDisable:true, FileCount:7}, daemon.runtimeLocalSkillSummary{Key:"system-prompts", Name:"system-prompts", Description:"Write system prompts, tool docs, and agent definitions. Project tag conventions + RFC 2119 keywords + dense compression. Use when authoring or editing any prompt the model reads.", SourcePath:"~/.agents/skills/system-prompts", Provider:"claude", Root:"universal", Plugin:"", CanDisable:true, FileCount:2}, daemon.runtimeLocalSkillSummary{Key:"systematic-debugging", Name:"systematic-debugging", Description:"Use when encountering any bug, test failure, or unexpected behavior, before proposing fixes", SourcePath:"~/.claude/skills/systematic-debugging", Provider:"claude", Root:"provider", Plugin:"", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"tavily-search", Name:"tavily-search", Description:"Search the web with LLM-optimized results via the Tavily CLI. Use this skill when the user wants to search the web, find articles, look up information, get recent news, discover sources, or says \"search for\", \"find me\", \"look up\", \"what's the latest on\", \"find articles about\", or needs current information from the internet. Returns relevant results with content snippets, relevance scores, and metadata — optimized for LLM consumption. Supports domain filtering, time ranges, and multiple search depths.", SourcePath:"~/.claude/skills/tavily-search", Provider:"claude", Root:"provider", Plugin:"", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"tdd", Name:"tdd", Description:"Test-driven development. Use when the user wants to build features or fix bugs test-first, mentions \"red-green-refactor\", or wants integration tests.", SourcePath:"~/.claude/skills/tdd", Provider:"claude", Root:"provider", Plugin:"", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"teach", Name:"teach", Description:"Teach the user a new skill or concept, within this workspace.", SourcePath:"~/.claude/skills/teach", Provider:"claude", Root:"provider", Plugin:"", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"test-driven-development", Name:"test-driven-development", Description:"Use when implementing any feature or bugfix, before writing implementation code", SourcePath:"~/.claude/skills/test-driven-development", Provider:"claude", Root:"provider", Plugin:"", CanDisable:true, FileCount:2}, daemon.runtimeLocalSkillSummary{Key:"to-questionnaire", Name:"to-questionnaire", Description:"Turn a decision you can't fully answer into a questionnaire for someone else to fill in.", SourcePath:"~/.claude/skills/to-questionnaire", Provider:"claude", Root:"provider", Plugin:"", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"to-spec", Name:"to-spec", Description:"Turn the current conversation into a spec and publish it to the project issue tracker: no interview, just synthesis of what you've already discussed.", SourcePath:"~/.claude/skills/to-spec", Provider:"claude", Root:"provider", Plugin:"", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"to-tickets", Name:"to-tickets", Description:"Break a plan, spec, or the current conversation into a set of tracer-bullet tickets, each declaring its blocking edges, published to the configured tracker (edges as text in one file per ticket locally, or native blocking links on a real tracker).", SourcePath:"~/.claude/skills/to-tickets", Provider:"claude", Root:"provider", Plugin:"", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"triage", Name:"triage", Description:"Move issues and external PRs through a state machine of triage roles, categorise, verify, grill if needed, and write agent-ready briefs.", SourcePath:"~/.claude/skills/triage", Provider:"claude", Root:"provider", Plugin:"", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"using-git-worktrees", Name:"using-git-worktrees", Description:"Use when starting feature work that needs isolation from current workspace or before executing implementation plans - ensures an isolated workspace exists via native tools or git worktree fallback", SourcePath:"~/.claude/skills/using-git-worktrees", Provider:"claude", Root:"provider", Plugin:"", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"using-superpowers", Name:"using-superpowers", Description:"Use when starting any conversation - establishes how to find and use skills, requiring skill invocation before ANY response including clarifying questions", SourcePath:"~/.claude/skills/using-superpowers", Provider:"claude", Root:"provider", Plugin:"", CanDisable:true, FileCount:6}, daemon.runtimeLocalSkillSummary{Key:"verification-before-completion", Name:"verification-before-completion", Description:"Use when about to claim work is complete, fixed, or passing, before committing or creating PRs - requires running verification commands and confirming output before making any success claims; evidence before assertions always", SourcePath:"~/.claude/skills/verification-before-completion", Provider:"claude", Root:"provider", Plugin:"", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"wait-what", Name:"wait-what", Description:"Stop. That last message did not land: re-pitch it.", SourcePath:"~/.claude/skills/wait-what", Provider:"claude", Root:"provider", Plugin:"", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"wayfinder", Name:"wayfinder", Description:"Plan a huge chunk of work (more than one agent session can hold) as a shared map of decision tickets on your issue tracker, and resolve them one at a time until the way to the destination is clear.", SourcePath:"~/.claude/skills/wayfinder", Provider:"claude", Root:"provider", Plugin:"", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"wizard", Name:"wizard", Description:"Generate an interactive bash wizard that walks a human through steps only they can perform. Use when provisioning infrastructure, setting up credentials or CI secrets, walking an unfamiliar third-party dashboard, or running a one-off migration or cutover. Don't invoke this for steps the agent can perform itself.", SourcePath:"~/.claude/skills/wizard", Provider:"claude", Root:"provider", Plugin:"", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"writing-beats", Name:"writing-beats", Description:"Writing, exploit; assemble raw material into a journey of beats, grounding each term before a beat leans on it.", SourcePath:"~/.claude/skills/writing-beats", Provider:"claude", Root:"provider", Plugin:"", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"writing-for-agents", Name:"writing-for-agents", Description:"Writing documents for agents. Use when creating or editing skills, or modifying AGENTS.md or CLAUDE.md.", SourcePath:"~/.claude/skills/writing-for-agents", Provider:"claude", Root:"provider", Plugin:"", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"writing-fragments", Name:"writing-fragments", Description:"Writing, explore: mine raw fragments, no structure yet.", SourcePath:"~/.claude/skills/writing-fragments", Provider:"claude", Root:"provider", Plugin:"", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"writing-plans", Name:"writing-plans", Description:"Use when you have a spec or requirements for a multi-step task, before touching code", SourcePath:"~/.claude/skills/writing-plans", Provider:"claude", Root:"provider", Plugin:"", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"writing-shape", Name:"writing-shape", Description:"Writing, exploit: shape raw material into an article, paragraph by paragraph.", SourcePath:"~/.claude/skills/writing-shape", Provider:"claude", Root:"provider", Plugin:"", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"writing-skills", Name:"writing-skills", Description:"Use when creating new skills, editing existing skills, or verifying skills work before deployment", SourcePath:"~/.claude/skills/writing-skills", Provider:"claude", Root:"provider", Plugin:"", CanDisable:true, FileCount:7}}
