    local_skills_test.go:235: supported=true skills=[]daemon.runtimeLocalSkillSummary{daemon.runtimeLocalSkillSummary{Key:"a-stock-data:a-stock-data", Name:"a-stock-data:a-stock-data", Description:"当任务需要写代码实际获取A股及相关市场数据时使用——行情/K线(腾讯日周月前后复权+分钟线、通达信官网全市场盘后包、百度、mootdx)、研报(东财+新浪+同花顺+iwencai)、信号(热点/北向/龙虎榜/解禁/行业/板块资金流)、资金面(融资融券/大宗/股东户数/分红/资金流/ETF份额)、新闻(财联社/东财/华尔街见闻/新闻联播)、财务三表/F10/估值历史/ST名单、公告(巨潮)、打板(涨停池/连板/炸板率/监控池/异动)、ETF期权、舆情互动(互动易/上证e互动/热榜)、筹码分布、复权因子、申万行业变迁、宏观与利率(社融/PMI/中债收益率曲线/回购定盘利率/LPR/全球宏观日历)、指数成分/权重/估值/交易日历、期货与大宗商品(五家期货交易所日行情/商品与股指期权/持仓排名/实时期货/A50/上海金)、事件驱动(业绩预告/机构调研/增减持/回购/股权质押/新股申购)、可转债等真实数据。十五层·85端点(含5备胎)·34个来源·内嵌全部可运行代码，自包含零外部文件；优先用腾讯/交易所官方等不封IP源，东财接口已内置限流防封，主源被封可查「备用源速查」降级。仅在需要调用数据接口取数时使用：A股概念解释、投资观点讨论、策略问答等无需取数的话题不要加载本skill。", SourcePath:"~/.claude/plugins/cache/a-stock-data/a-stock-data/3.9.0/skills/a-stock-data", Provider:"claude", Root:"plugin", Plugin:"a-stock-data@a-stock-data", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"ask-matt", Name:"ask-matt", Description:"Ask which skill or flow fits your situation. A router over the skills in this repo.", SourcePath:"~/.claude/skills/ask-matt", Provider:"claude", Root:"provider", Plugin:"", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"brainstorming", Name:"brainstorming", Description:"You MUST use this before any creative work - creating features, building components, adding functionality, or modifying behavior. Explores user intent, requirements and design before implementation.", SourcePath:"~/.claude/skills/brainstorming", Provider:"claude", Root:"provider", Plugin:"", CanDisable:true, FileCount:8}, daemon.runtimeLocalSkillSummary{Key:"brandkit", Name:"brandkit", Description:"Premium brand-kit image generation skill for creating high-end brand-guidelines boards, logo systems, identity decks, and visual-world presentations. Trained for minimalist, cinematic, editorial, dark-tech, luxury, cultural, security, gaming, developer-tool, and consumer-app brand systems. Optimized for intentional logo concepting, refined composition, sparse typography, strong symbolic meaning, premium mockups, art-directed imagery, and flexible grid layouts.", SourcePath:"~/.claude/skills/brandkit", Provider:"claude", Root:"provider", Plugin:"", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"browser-use", Name:"browser-use", Description:"Drive the in-app browser — open a page, read it as an accessibility tree, click, type, fill forms, screenshot, and verify what the page really shows.", SourcePath:"~/.agents/skills/browser-use", Provider:"claude", Root:"universal", Plugin:"", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"claude-handoff", Name:"claude-handoff", Description:"Hand the current conversation off to a fresh background agent that picks up the work immediately.", SourcePath:"~/.claude/skills/claude-handoff", Provider:"claude", Root:"provider", Plugin:"", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"code-review", Name:"code-review", Description:"Review the changes since a fixed point (commit, branch, tag, or merge-base) along two axes: Standards (does the code follow this repo's documented coding standards?) and Spec (does the code match what the originating issue/spec asked for?). Runs both reviews in parallel sub-agents and reports them side by side. Use when the user wants to review a branch, a PR, work-in-progress changes, or asks to \"review since X\".", SourcePath:"~/.claude/skills/code-review", Provider:"claude", Root:"provider", Plugin:"", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"codebase-design", Name:"codebase-design", Description:"Shared vocabulary for designing deep modules. Use when the user wants to design or improve a module's interface, find deepening opportunities, decide where a seam goes, make code more testable or AI-navigable, or when another skill needs the deep-module vocabulary.", SourcePath:"~/.claude/skills/codebase-design", Provider:"claude", Root:"provider", Plugin:"", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"computer-use", Name:"computer-use", Description:"Drive a macOS app through the `computer` tool — read its accessibility tree, act on elements, and use real input only when the tree cannot reach the target.", SourcePath:"~/.agents/skills/computer-use", Provider:"claude", Root:"universal", Plugin:"", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"design-taste-frontend", Name:"design-taste-frontend", Description:"Anti-slop frontend skill for landing pages, portfolios, and redesigns. The agent reads the brief, infers the right design direction, and ships interfaces that do not look templated. Real design systems when applicable, audit-first on redesigns, strict pre-flight check.", SourcePath:"~/.claude/skills/design-taste-frontend", Provider:"claude", Root:"provider", Plugin:"", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"design-taste-frontend-v1", Name:"design-taste-frontend-v1", Description:"The original v1 taste-skill, preserved for projects depending on its exact behavior. The current default is `design-taste-frontend` (v2 experimental), which is a substantial rewrite. Use this v1 install name only if you need exact backward compatibility.", SourcePath:"~/.claude/skills/design-taste-frontend-v1", Provider:"claude", Root:"provider", Plugin:"", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"diagnosing-bugs", Name:"diagnosing-bugs", Description:"Diagnosis loop for hard bugs and performance regressions. Use when the user says \"diagnose\"/\"debug this\", or reports something broken/throwing/failing/slow.", SourcePath:"~/.claude/skills/diagnosing-bugs", Provider:"claude", Root:"provider", Plugin:"", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"dispatching-parallel-agents", Name:"dispatching-parallel-agents", Description:"Use when facing 2+ independent tasks that can be worked on without shared state or sequential dependencies", SourcePath:"~/.claude/skills/dispatching-parallel-agents", Provider:"claude", Root:"provider", Plugin:"", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"domain-modeling", Name:"domain-modeling", Description:"Build and sharpen a project's domain model. Use when discussing codebase terminology, writing or editing a CONTEXT.md, or recording or editing an ADR.", SourcePath:"~/.claude/skills/domain-modeling", Provider:"claude", Root:"provider", Plugin:"", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"earnings-reviewer:audit-xls", Name:"earnings-reviewer:audit-xls", Description:"Audit a spreadsheet for formula accuracy, errors, and common mistakes. Scopes to a selected range, a single sheet, or the entire model (including financial-model integrity checks like BS balance, cash tie-out, and logic sanity). Triggers on \"audit this sheet\", \"check my formulas\", \"find formula errors\", \"QA this spreadsheet\", \"sanity check this\", \"debug model\", \"model check\", \"model won't balance\", \"something's off in my model\", \"model review\".", SourcePath:"~/.claude/plugins/cache/claude-for-financial-services/earnings-reviewer/0.1.1/skills/audit-xls", Provider:"claude", Root:"plugin", Plugin:"earnings-reviewer@claude-for-financial-services", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"earnings-reviewer:earnings-analysis", Name:"earnings-reviewer:earnings-analysis", Description:"Create professional equity research earnings update reports (8-12 pages, 3,000-5,000 words) analyzing quarterly results for companies already under coverage. Fast-turnaround format focusing on beat/miss analysis, key metrics, updated estimates, and revised thesis. Includes 1-3 summary tables and 8-12 charts. Use when user requests \"earnings update\", \"quarterly update\", \"earnings analysis\", \"Q1/Q2/Q3/Q4 results\", or post-earnings report.", SourcePath:"~/.claude/plugins/cache/claude-for-financial-services/earnings-reviewer/0.1.1/skills/earnings-analysis", Provider:"claude", Root:"plugin", Plugin:"earnings-reviewer@claude-for-financial-services", CanDisable:true, FileCount:4}, daemon.runtimeLocalSkillSummary{Key:"earnings-reviewer:earnings-preview", Name:"earnings-reviewer:earnings-preview", Description:"Build pre-earnings analysis with estimate models, scenario frameworks, and key metrics to watch. Use before a company reports quarterly earnings to prepare positioning notes, set up bull/bear scenarios, and identify what will move the stock. Triggers on \"earnings preview\", \"what to watch for [company] earnings\", \"pre-earnings\", \"earnings setup\", or \"preview Q[X] for [company]\".", SourcePath:"~/.claude/plugins/cache/claude-for-financial-services/earnings-reviewer/0.1.1/skills/earnings-preview", Provider:"claude", Root:"plugin", Plugin:"earnings-reviewer@claude-for-financial-services", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"earnings-reviewer:model-update", Name:"earnings-reviewer:model-update", Description:"Update financial models with new data — quarterly earnings, management guidance, macro changes, or revised assumptions. Adjusts estimates, recalculates valuation, and flags material changes. Use after earnings, guidance updates, or when assumptions need refreshing. Triggers on \"update model\", \"plug earnings\", \"refresh estimates\", \"update numbers for [company]\", \"new guidance\", or \"revise estimates\".", SourcePath:"~/.claude/plugins/cache/claude-for-financial-services/earnings-reviewer/0.1.1/skills/model-update", Provider:"claude", Root:"plugin", Plugin:"earnings-reviewer@claude-for-financial-services", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"earnings-reviewer:morning-note", Name:"earnings-reviewer:morning-note", Description:"Draft concise morning meeting notes summarizing overnight developments, trade ideas, and key events for coverage stocks. Designed for the 7am morning meeting format — tight, opinionated, actionable. Triggers on \"morning note\", \"morning meeting\", \"what happened overnight\", \"trade idea\", \"morning call prep\", or \"daily note\".", SourcePath:"~/.claude/plugins/cache/claude-for-financial-services/earnings-reviewer/0.1.1/skills/morning-note", Provider:"claude", Root:"plugin", Plugin:"earnings-reviewer@claude-for-financial-services", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"earnings-reviewer:xlsx-author", Name:"earnings-reviewer:xlsx-author", Description:"Produce a .xlsx file on disk (headless) instead of driving a live Excel workbook — for managed-agent sessions with no open Office app.", SourcePath:"~/.claude/plugins/cache/claude-for-financial-services/earnings-reviewer/0.1.1/skills/xlsx-author", Provider:"claude", Root:"plugin", Plugin:"earnings-reviewer@claude-for-financial-services", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"equity-research:catalyst-calendar", Name:"equity-research:catalyst-calendar", Description:"Build and maintain a calendar of upcoming catalysts across a coverage universe — earnings dates, conferences, product launches, regulatory decisions, and macro events. Helps prioritize attention and position ahead of events. Triggers on \"catalyst calendar\", \"upcoming events\", \"what's coming up\", \"earnings calendar\", \"event calendar\", or \"catalyst tracker\".", SourcePath:"~/.claude/plugins/cache/claude-for-financial-services/equity-research/0.1.2/skills/catalyst-calendar", Provider:"claude", Root:"plugin", Plugin:"equity-research@claude-for-financial-services", CanDisable:true, FileCount:1}, daemon.runtimeLocalSkillSummary{Key:"equity-research:earnings-analysis", Name:"equity-research:earnings-analysis", Description:"Create professional equity research earnings update reports (8-12 pages, 3,000-5,000 words) analyzing quarterly results for companies already under coverage. Fast-turnaround format focusing on beat/miss ana