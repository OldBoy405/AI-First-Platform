$ node -e const fs = require('fs'), P = require('path'), crypto = require('crypto'); const R = process.cwd(), NL = String.fromCharCode(10), CRLF = String.fromCharCode(13, 10); const read = (p) => fs.readFileSync(P.join(R, p), 'utf8').split(CRLF).join(NL); const exists = (p) => fs.existsSync(P.join(R, p)); const any2 = (xs) => { for (const x of xs) { if (x) { return true; } } return false; }; const sha = (s) => crypto.createHash('sha256').update(s).digest('hex'); const bad = []; const D = 'change-requests/CR-2026-069/evidence/'; const need = (label, t, toks) => { for (const k of toks) { if (t.indexOf(k) < 0) { bad.push('FAIL ' + label + ' missing ' + k); } } }; let bl = null; if (!exists(D + 'fr8-baseline.json')) { bad.push('FAIL 缺 ' + D + 'fr8-baseline.json'); } else { const raw = read(D + 'fr8-baseline.json'); if (raw.length < 200) { bad.push('FAIL fr8-baseline.json 读空或过短 length=' + raw.length); } try { bl = JSON.parse(raw); } catch (e) { bad.push('FAIL fr8-baseline.json 解析失败 ' + e.message); } if (bl) { for (const k of ['window', 'sampleCRs', 'coverage', 'providerUsage', 'toolResultTokens', 'k', 'metrics', 'guardrails', 'crctlCommands', 'tokenEstimator', 'costSource', 'observedAt', 'rule']) { if (bl[k] === undefined) { bad.push('FAIL fr8-baseline.json 缺字段 ' + k); } } const mt = bl.metrics == null ? {} : bl.metrics; for (const k of ['tokensPerCR', 'sessionsPerCR', 'searchTokenRatio', 'fullReadRatio', 'bootstrapTokensPerSession']) { if (mt[k] === undefined) { bad.push('FAIL metrics 缺 ' + k); } } const gd = bl.guardrails == null ? {} : bl.guardrails; for (const k of ['firstPassGateRate', 'reviewLoopsPerCR', 'reviewDefectsPerCR']) { if (gd[k] === undefined) { bad.push('FAIL guardrails 缺 ' + k); } } const cu = bl.providerUsage == null ? {} : bl.providerUsage; for (const k of ['input', 'cachedInput', 'cacheWrite', 'output']) { if (cu[k] === undefined) { bad.push('FAIL providerUsage 缺 ' + k); } } if (bl.costSource === 'unavailable' && bl.k !== null) { bad.push('FAIL costSource=unavailable 时 k 必须为 null'); } const ctl = Array.isArray(bl.crctlCommands) ? bl.crctlCommands : null; if (any2([ctl === null, ctl.length < 1])) { bad.push('FAIL crctlCommands 缺失或空'); } else { for (const x of ctl) { if (any2([typeof x.command !== 'string', typeof x.tokens !== 'number', typeof x.calls !== 'number'])) { bad.push('FAIL crctlCommands 行缺 command/tokens/calls: ' + JSON.stringify(x).slice(0, 80)); } } } } } if (!exists(D + 'ac10-selection.json')) { bad.push('FAIL 缺 ' + D + 'ac10-selection.json'); } else if (bl !== null) { const raw = read(D + 'ac10-selection.json'); let sel = null; try { sel = JSON.parse(raw); } catch (e) { bad.push('FAIL ac10-selection.json 解析失败 ' + e.message); } if (sel) { const blSha = sha(read(D + 'fr8-baseline.json')); if (sel.baselineSha256 !== blSha) { bad.push('FAIL ac10-selection.baselineSha256 = ' + sel.baselineSha256 + ' != sha256(LF, fr8-baseline.json) ' + blSha); } const rk = Array.isArray(sel.registryKeys) ? sel.registryKeys.slice().sort() : null; const ms = Array.isArray(sel.minimalSet) ? sel.minimalSet.slice().sort() : null; if (any2([!rk, rk.length < 1])) { bad.push('FAIL ac10-selection.registryKeys 缺失或空'); } if (any2([!ms, ms.length < 1])) { bad.push('FAIL ac10-selection.minimalSet 缺失或空'); } if (rk && ms && JSON.stringify(rk) !== JSON.stringify(ms)) { bad.push('FAIL ac10-selection 注册表键集 != minimalSet'); } if (sel.verdict !== 'pass') { bad.push('FAIL ac10-selection.verdict = ' + sel.verdict); } if (any2([sel.observedAt === undefined, sel.rule === undefined])) { bad.push('FAIL ac10-selection 缺 observedAt/rule'); } const ctl = Array.isArray(bl.crctlCommands) ? bl.crctlCommands.slice() : []; if (ctl.length > 0 && ms) { ctl.sort((a, b) => (b.tokens - a.tokens !== 0 ? b.tokens - a.tokens : (a.command < b.command ? -1 : a.command > b.command ? 1 : 0))); const total = ctl.reduce((s, x) => s + x.tokens, 0); const derived = []; let acc = 0; for (const x of ctl) { derived.push(x.command); acc += x.tokens; if (total > 0 && acc / total >= 0.8) { break; } } if (JSON.stringify(derived.slice().sort()) !== JSON.stringify(ms)) { bad.push('FAIL 独立重算的最小集合 ' + JSON.stringify(derived) + ' != evidence minimalSet ' + JSON.stringify(ms) + '（口径见证据命令表表注）'); } else { console.log('ac10 独立重算最小集合 = ' + derived.length + ' 项，与 evidence.minimalSet 全等'); } } } } if (!exists(D + 'ac9-sampling.md')) { bad.push('FAIL 缺 ' + D + 'ac9-sampling.md'); } else { const t = read(D + 'ac9-sampling.md'); if (t.length < 500) { bad.push('FAIL ac9-sampling.md 过短 length=' + t.length); } need('ac9-sampling.md', t, ['抽检', '误伤', '样本']); } if (!exists(D + 'ac14-smoke.md')) { bad.push('FAIL 缺 ' + D + 'ac14-smoke.md'); } else { const t = read(D + 'ac14-smoke.md'); if (t.length < 500) { bad.push('FAIL ac14-smoke.md 过短 length=' + t.length); } for (const rt of ['pi', 'claude', 'codebuddy', 'qoder', 'codex']) { if (t.indexOf('runtime=' + rt) < 0) { bad.push('FAIL ac14-smoke.md 缺 ' + rt + ' 的 check-install 读数（output-guard runtime=' + rt + '）'); } const i0 = t.indexOf('runtime=' + rt); const i1 = i0 < 0 ? -1 : t.indexOf('runtime=', i0 + 1); const seg = i0 < 0 ? '' : t.slice(i0, i1 < 0 ? i0 + 3000 : i1); for (const k of ['拒绝', '裁剪', '逃生', '降级']) { if (seg.indexOf(k) < 0 && seg.indexOf('ENVIRONMENT_MISMATCH') < 0) { bad.push('FAIL ac14-smoke.md ' + rt + ' 段缺四类行为观测关键词 ' + k); } } } if (t.indexOf('拒绝') < 0) { bad.push('FAIL ac14-smoke.md 全文缺四类行为观测'); } if (t.indexOf('ENVIRONMENT_MISMATCH') >= 0) { need('ac14-smoke.md 环境中止段', t, ['所需建立动作']); } } if (bad.length) { console.log('audit-evidence failures = ' + bad.length); for (const x of bad) { console.log(x); } process.exit(1); } console.log('audit-evidence failures = 0');
