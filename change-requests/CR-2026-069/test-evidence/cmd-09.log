$ node -e const cp = require('child_process'), fs = require('fs'), P = require('path'); const R = process.cwd(), NL = String.fromCharCode(10), CRLF = String.fromCharCode(13, 10); const bad = []; const any2 = (xs) => { for (const x of xs) { if (x) { return true; } } return false; }; const COV = ['coverage=full', 'coverage=partial', 'coverage=unavailable']; const CRCTL = P.join(R, 'skills/shared/crctl/scripts/crctl.mjs'); const gitStatus = () => { const r = cp.spawnSync(process.execPath, [CRCTL, 'git', 'status', '--porcelain', '--cwd', R], { encoding: 'utf8', shell: false }); if (r.status !== 0) { bad.push('FAIL crctl git status status=' + r.status); return null; } const out = String(r.stdout == null ? '' : r.stdout).split(CRLF).join(NL); const parts = out.split(NL); const bi = parts.findIndex((l) => l.trim() === '{'); return parts.slice(0, bi < 0 ? parts.length : bi).join(NL).trim(); }; const before = gitStatus(); const CI = P.join(R, 'output-guard/scripts/check-install.mjs'); if (!fs.existsSync(CI)) { bad.push('FAIL 缺 output-guard/scripts/check-install.mjs'); } else { const r = cp.spawnSync(process.execPath, [CI, '--tools-root', '.'], { cwd: R, encoding: 'utf8', shell: false }); const out = String(r.stdout == null ? '' : r.stdout).split(CRLF).join(NL); const err = String(r.stderr == null ? '' : r.stderr).split(CRLF).join(NL); console.log('[check-install] exit=' + r.status); console.log(out.trim()); if (r.status !== 0) { bad.push('FAIL check-install exit=' + r.status + ' stderr=' + err.slice(-300)); } const lines = out.split(NL).filter((l) => l.trim()); for (const rt of ['pi', 'claude', 'codebuddy', 'qoder', 'codex']) { const hit = lines.filter((l) => { const tk = l.trim().split(' '); if (tk.length !== 4) { return false; } return tk[0] === 'output-guard' && tk[1] === 'runtime=' + rt && COV.indexOf(tk[2]) >= 0 && tk[3] === 'policy=v1'; }); if (hit.length !== 1) { bad.push('FAIL check-install runtime=' + rt + ' 行数 = ' + hit.length + '（期望恰 1 行稳定形态）'); } } for (const l of lines) { const low = l.toLowerCase(); if (any2(['install', 'writing', 'created', 'fixed'].map((x) => low.indexOf(x) >= 0))) { bad.push('FAIL check-install 输出出现安装/写动作语义: ' + l.slice(0, 120)); } } } const after = gitStatus(); if (before !== null && after !== null && before !== after) { bad.push('FAIL check-install 前后 worktree 状态漂移（只读负向）'); console.log('before=' + before); console.log('after=' + after); } else if (before !== null) { console.log('read-only negative: worktree status unchanged (empty=' + (before === '') + ')'); } if (bad.length) { console.log('audit-check-install failures = ' + bad.length); for (const x of bad) { console.log(x); } process.exit(1); } console.log('audit-check-install failures = 0');
(exit=0)
